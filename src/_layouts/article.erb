---
layout: default
---
<article>
  <header id="single_header" class="article-header">
    <h1 class="article-title"><%= data.title %></h1>
    <div class="article-meta">
      <% if data.date %>
        <div class="article-byline">
          <time datetime="<%= data.date.iso8601 %>"><%= data.date.strftime("%-d %B %Y") %></time>
          <span class="article-separator">&middot;</span>
          <% word_count = resource.content.to_s.gsub(/<[^>]+>/, " ").split.size %>
          <span><%= word_count %> words</span>
        </div>
      <% end %>
      <% if data.tags %>
        <div class="article-tags">
          <% Array(data.tags).each do |tag| %>
            <a class="tag-badge" href="/tags/<%= tag.downcase.gsub(/[^a-z0-9+]+/, "-").sub(/-+$/, "") %>/">
              <%= tag %>
            </a>
          <% end %>
        </div>
      <% end %>
    </div>
  </header>
  <section class="content-shell">
    <div class="content-column">
      <div class="article-content prose">
        <%= yield %>
      </div>
    </div>
  </section>
</article>
