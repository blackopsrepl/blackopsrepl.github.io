<!doctype html>
<html lang="<%= site.metadata.locale %>" dir="ltr" class="dark site-document">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color">
    <title><%= data.title ? "#{data.title} · #{site.metadata.title}" : site.metadata.title %></title>
    <meta name="title" content="<%= data.title || site.metadata.title %>">
    <meta name="description" content="<%= data.description || site.metadata.description %>">
    <meta name="author" content="<%= site.metadata.author %>">
    <% canonical_path = resource.relative_url.to_s.sub(%r{\A/+}, "/") %>
    <% canonical_path = "" if canonical_path == "/" %>
    <link rel="canonical" href="<%= site.metadata.url.chomp("/") %><%= canonical_path %>">
    <link rel="stylesheet" href="/css/site.css">
  </head>
  <body class="site-body">
    <div id="the-top"></div>
    <%= render "header" %>
    <div class="site-content">
      <main id="main-content" class="site-main">
        <%= yield %>
      </main>
      <%= render "scroll_to_top" %>
      <%= render "footer" %>
      <%= render "search" %>
    </div>
    <script defer src="/vendor/mermaid.js"></script>
    <script defer src="/_bridgetown/static/js/site.js"></script>
  </body>
</html>
