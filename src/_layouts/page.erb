---
layout: default
---
<header class="page-header">
  <h1 class="page-title"><%= data.title %></h1>
</header>
<section class="content-shell">
  <div class="content-column prose">
    <%= yield %>
  </div>
</section>
<% section = resource.relative_path.to_s.split("/").first %>
<% if %w[portfolio demos blog].include?(section) %>
  <%= render "listing", section: section %>
<% end %>
