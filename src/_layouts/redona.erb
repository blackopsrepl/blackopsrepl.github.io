<!doctype html>
<html lang="<%= data.lang || "it" %>" dir="ltr" class="rb-document">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#b4121f">
    <title><%= data.title %></title>
    <meta name="description" content="<%= data.description %>">
    <meta name="author" content="<%= site.metadata.author %>">
    <% page_url = "#{site.metadata.url.chomp("/")}#{resource.relative_url}" %>
    <link rel="canonical" href="<%= page_url %>">
    <% base = site.metadata.url.chomp("/") %>
    <link rel="alternate" hreflang="it" href="<%= base %>/redona/">
    <link rel="alternate" hreflang="zh-Hans" href="<%= base %>/redona/zh/">
    <link rel="alternate" hreflang="x-default" href="<%= base %>/redona/">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="<%= data.og_locale || "it_IT" %>">
    <meta property="og:title" content="<%= data.title %>">
    <meta property="og:description" content="<%= data.description %>">
    <meta property="og:url" content="<%= page_url %>">
    <meta property="og:image" content="<%= site.metadata.url.chomp("/") %>/redona/img/baffo-microfono.jpg">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" type="image/svg+xml" href="/redona/img/favicon.svg">
    <link rel="preload" href="/redona/fonts/Anton-Regular.ttf" as="font" type="font/ttf" crossorigin>
    <% Array(data.preload_fonts).each do |font| %>
    <link rel="preload" href="<%= font %>" as="font" type="font/woff2" crossorigin>
    <% end %>
    <%# GitHub Pages caches for 10 minutes; a content hash in the URL makes every deploy fetch the new stylesheet %>
    <link rel="stylesheet" href="/redona/redona.css?v=<%= Digest::SHA256.file(File.join(site.source, "redona/redona.css")).hexdigest[0, 12] %>">
  </head>
  <body class="rb">
    <%= yield %>
    <script>
      (() => {
        const clock = document.querySelector("[data-rb-clock]");
        if (clock) {
          const format = new Intl.DateTimeFormat("it-IT", { hour: "2-digit", minute: "2-digit", second: "2-digit", timeZone: "Europe/Rome" });
          const tick = () => { clock.textContent = format.format(new Date()); };
          tick();
          setInterval(tick, 1000);
        }
        const reveal = document.querySelectorAll("[data-rb-reveal]");
        if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("rb-motion");
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                observer.unobserve(entry.target);
              }
            });
          }, { rootMargin: "0px 0px -8% 0px" });
          reveal.forEach((node) => observer.observe(node));
        }
        const clips = document.querySelectorAll("[data-rb-clip]");
        if (clips.length && "IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          const playing = new Set();
          const track = () => {
            playing.forEach((video) => {
              if (video.duration) {
                video.parentElement.style.setProperty("--p", (video.currentTime / video.duration).toFixed(4));
              }
            });
            if (playing.size) requestAnimationFrame(track);
          };
          const clipObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              const video = entry.target;
              if (entry.isIntersecting) {
                video.preload = "auto";
                video.play().then(() => {
                  const wasIdle = !playing.size;
                  playing.add(video);
                  if (wasIdle) requestAnimationFrame(track);
                }).catch(() => {});
              } else {
                video.pause();
                playing.delete(video);
              }
            });
          }, { threshold: 0.35 });
          clips.forEach((video) => clipObserver.observe(video));
        }
        // Language switch keeps your place: remember which section is in view
        // and how far into it, then restore it on the other language's page.
        // Sections missing on the other page fall through to the next one.
        const ORDER = ["hero", "intro", "steps", "reel", "tech", "rules", "auto", "who", "price", "faq", "final"];
        const KEY = "rb-lang-place";
        const sections = [...document.querySelectorAll("[data-rb-section]")];
        const navHeight = () => document.querySelector(".rb-nav")?.offsetHeight || 0;
        document.querySelectorAll("[data-rb-lang]").forEach((link) => link.addEventListener("click", () => {
          const line = navHeight() + 1;
          const current = sections.filter((s) => s.getBoundingClientRect().top <= line).pop() || sections[0];
          if (!current) return;
          const box = current.getBoundingClientRect();
          const ratio = Math.min(1, Math.max(0, (line - box.top) / box.height));
          try { sessionStorage.setItem(KEY, JSON.stringify({ key: current.dataset.rbSection, ratio, top: scrollY < 8 })); } catch (_) {}
        }));
        let place = null;
        try { place = JSON.parse(sessionStorage.getItem(KEY)); sessionStorage.removeItem(KEY); } catch (_) {}
        if (place && place.top) place = null;
        if (place && !location.hash) {
          const byKey = Object.fromEntries(sections.map((s) => [s.dataset.rbSection, s]));
          const start = Math.max(0, ORDER.indexOf(place.key));
          const exact = byKey[place.key];
          const target = exact || ORDER.slice(start).map((k) => byKey[k]).find(Boolean);
          if (target) {
            const ratio = exact ? place.ratio : 0;
            const go = () => {
              const y = target.getBoundingClientRect().top + scrollY + target.offsetHeight * ratio - navHeight();
              document.documentElement.style.scrollBehavior = "auto";
              scrollTo(0, Math.max(0, Math.round(y)));
              document.documentElement.style.scrollBehavior = "";
              return Math.max(0, Math.round(y));
            };
            // Web fonts change section heights after first paint; aim again once
            // they load, unless the reader has started scrolling in the meantime.
            let landed = go();
            const again = () => { if (Math.abs(scrollY - landed) < 4) landed = go(); };
            document.fonts?.ready.then(again);
            addEventListener("load", again, { once: true });
          }
        }
      })();
    </script>
  </body>
</html>
