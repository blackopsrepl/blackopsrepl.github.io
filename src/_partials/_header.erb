<header class="site-header">
  <div class="main-menu">
    <div class="brand-mark">
      <a href="/" class="brand-mark-link">
      <span class="sr-only"><%= site.metadata.title %></span>
        <img src="/logo.png" width="100" height="100" class="brand-mark-image" alt="">
      </a>
    </div>

    <div class="header-primary">
      <nav class="brand-wordmark">
        <a href="/" class="brand-wordmark-link">
        <span class="sr-only"><%= site.metadata.title %></span>
        <span class="logo-text"><%= render "logo" %></span>
        </a>
      </nav>

      <nav class="desktop-nav" aria-label="Primary">
        <% site.metadata.navigation.each do |item| %>
          <a href="<%= item.path %>" aria-label="<%= item.name %>" title="<%= item.name %>"><%= item.name %></a>
        <% end %>
        <button id="search-button" aria-label="Search" title="Search (/)" type="button">
          <%= render "icon", icon: "search" %>
        </button>
      </nav>

      <div class="mobile-tools">
        <button id="search-button-mobile" aria-label="Search" title="Search (/)" type="button">
          <%= render "icon", icon: "search" %>
        </button>
      </div>
    </div>

    <div class="mobile-menu-control">
      <button id="menu-button" aria-label="Open menu" aria-expanded="false" type="button">
        <%= render "icon", icon: "bars" %>
      </button>
      <div id="menu-wrapper" class="mobile-menu" aria-hidden="true">
        <ul class="mobile-menu-list">
        <li>
          <button id="menu-close-button" aria-label="Close menu" type="button">
            <%= render "icon", icon: "xmark" %>
          </button>
        </li>
        <% site.metadata.navigation.each do |item| %>
          <li>
            <a href="<%= item.path %>" aria-label="<%= item.name %>" title="<%= item.name %>"><%= item.name %></a>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
  </div>
</header>
