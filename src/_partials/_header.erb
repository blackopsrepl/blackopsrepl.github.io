<div class="main-menu flex items-center justify-between py-6 md:justify-start gap-x-3 pt-[2px] pr-2 md:pr-4 pb-[3px] pl-0">
  <div>
    <a href="/" class="flex">
      <span class="sr-only"><%= site.metadata.title %></span>
      <img src="/logo.png" width="100" height="100" class="logo max-h-[5rem] max-w-[5rem] object-scale-down object-left nozoom" alt="">
    </a>
  </div>

  <div class="flex flex-1 items-center justify-between">
    <nav class="flex space-x-3 items-center">
      <a href="/" class="block nozoom">
        <span class="sr-only"><%= site.metadata.title %></span>
        <span class="logo-text"><%= render "logo" %></span>
      </a>
    </nav>

    <nav class="hidden md:flex items-center gap-x-5 md:ml-12 h-12">
      <% site.metadata.navigation.each do |item| %>
        <a href="<%= item.path %>" class="flex items-center hover:text-primary-600 dark:hover:text-primary-400" aria-label="<%= item.name %>" title="<%= item.name %>">
          <p class="text-base font-medium"><%= item.name %></p>
        </a>
      <% end %>
      <button id="search-button" aria-label="Search" class="text-base hover:text-primary-600 dark:hover:text-primary-400" title="Search (/)" type="button">
        <%= render "icon", icon: "search" %>
      </button>
    </nav>

    <div class="flex md:hidden items-center gap-x-5 md:ml-12 h-12">
      <span></span>
      <button id="search-button-mobile" aria-label="Search" class="text-base hover:text-primary-600 dark:hover:text-primary-400" title="Search (/)" type="button">
        <%= render "icon", icon: "search" %>
      </button>
    </div>
  </div>

  <div class="-my-2 md:hidden">
    <div id="menu-button" class="block">
      <div class="cursor-pointer hover:text-primary-600 dark:hover:text-primary-400">
        <%= render "icon", icon: "bars" %>
      </div>
      <div id="menu-wrapper" class="fixed inset-0 z-30 invisible w-screen h-screen m-0 overflow-auto transition-opacity opacity-0 cursor-default bg-neutral-100/50 backdrop-blur-sm dark:bg-neutral-900/50 pt-[5px]">
        <ul class="flex space-y-2 mt-3 flex-col items-end w-full px-6 py-6 mx-auto overflow-visible list-none text-end max-w-7xl">
          <li id="menu-close-button">
            <span class="cursor-pointer inline-block align-text-bottom hover:text-primary-600 dark:hover:text-primary-400">
              <%= render "icon", icon: "xmark" %>
            </span>
          </li>
          <% site.metadata.navigation.each do |item| %>
            <li class="mt-1">
              <a href="<%= item.path %>" class="flex items-center hover:text-primary-600 dark:hover:text-primary-400" aria-label="<%= item.name %>" title="<%= item.name %>">
                <p class="text-bg font-bg"><%= item.name %></p>
              </a>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
