<div id="search-wrapper" class="search-overlay" data-url="/">
  <div id="search-modal" class="search-modal">
    <header class="search-header">
      <form class="search-form">
        <div class="search-icon"><%= render "icon", icon: "search" %></div>
        <input type="search" id="search-query" placeholder="Search" tabindex="0">
      </form>
      <button id="close-search-button" title="Close (Esc)" type="button">
        <%= render "icon", icon: "xmark" %>
      </button>
    </header>
    <section class="search-results"><ul id="search-results"></ul></section>
  </div>
</div>
