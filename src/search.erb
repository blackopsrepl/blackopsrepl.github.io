---
layout: false
permalink: /index.json
---
<% require "json" %>
<% entries = site.resources.filter_map do |item|
  next if item.relative_url == "/" || item.data.draft == true

  {
    title: item.data.title.to_s,
    section: item.relative_url.split("/")[1].to_s.capitalize,
    summary: item.data.description.to_s,
    content: item.content.to_s.gsub(/<[^>]+>/, " ").split.join(" "),
    permalink: item.relative_url,
    date: item.data.date&.strftime("%-d %B %Y"),
    externalUrl: item.data.externalUrl,
  }
end %>
<%= JSON.generate(entries).html_safe %>
